{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebPush": {
    "Enabled": false
  },
  "GitHubCacheWarmup": {
    "Enabled": true,
    "EnabledInDevelopment": false,
    "State": "open",
    "RefreshIntervalMinutes": 60,
    "Repositories": [
      "microsoft/aspire",
      "microsoft/aspire.dev",
      "microsoft/aspire-skills",
      "microsoft/dcp",
      "CommunityToolkit/Aspire"
    ]
  },
  "GitHubReviewPolicy": {
    "RequireConversationResolution": [
      "microsoft/aspire"
    ]
  },
  "CiHealth": {
    "Enabled": true,
    "EnabledInDevelopment": false,
    "Repositories": [],
    "PulseWindowHours": 36,
    "WeeklyWindowDays": 7,
    "PulseRefreshMinutes": 60,
    "WeeklyRefreshHours": 24,
    "StreakThreshold": 3,
    "TrackBotIssues": true,
    "Lanes": {
      "microsoft/aspire": {
        "MainWorkflows": [
          "CI",
          "Outerloop Tests"
        ],
        "Branches": [
          "main",
          "release/*"
        ],
        "AlwaysShowScheduled": [
          "Quarantined Tests",
          "Deployment E2E Tests"
        ],
        "SkipScheduled": []
      },
      "microsoft/dcp": {
        "MainWorkflows": [
          "Build and Test"
        ],
        "Branches": [
          "main"
        ]
      }
    }
  }
}