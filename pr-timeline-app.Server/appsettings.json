{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebPush": {
    "Enabled": false
  },
  "GitHubCacheWarmup": {
    "Enabled": true,
    "EnabledInDevelopment": false,
    "State": "open",
    "RefreshIntervalMinutes": 60,
    "Repositories": [
      "microsoft/aspire",
      "microsoft/aspire.dev",
      "microsoft/aspire-skills",
      "microsoft/dcp",
      "CommunityToolkit/Aspire"
    ]
  },
  "GitHubReviewPolicy": {
    "RequireConversationResolution": [
      "microsoft/aspire"
    ]
  },
  "CiHealth": {
    "Enabled": true,
    "EnabledInDevelopment": false,
    "Repositories": [],
    "Workflows": {},
    "PulseWindowHours": 36,
    "WeeklyWindowDays": 7,
    "PulseRefreshMinutes": 60,
    "WeeklyRefreshHours": 24,
    "StreakThreshold": 3
  }
}
